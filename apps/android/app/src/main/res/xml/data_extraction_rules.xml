<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The field cache is re-downloadable; only the grower's water limits (DataStore) are worth backing up. -->
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
