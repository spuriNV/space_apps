# secrets
.env
.env.*
!.env.example
.netrc

# dependencies and build output
node_modules/
dist/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.vite/

# OS
.DS_Store

# personal Claude Code settings
.claude/settings.local.json

# per-field raw rasters (CDL box, S2 NDVI stack) and AppEEARS bundles are rebuilt by the chunk scripts
data/cache/*/rasters/
data/cache/_appeears/

# analyse-any-location cache (backend/api/app/anyloc; rebuilt on demand)
data/cache/_points/

# user-drawn fields cache (backend/api/app/myfields; optional, rebuilt on demand)
data/user_fields/
# national SLC zip, read once by backend/catalog/slc_bc.py (the BC summary it writes is committed)
data/cache/_slc/
data/cache/rain/
