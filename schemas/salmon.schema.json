{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/salmon.schema.json",
  "title": "Salmon",
  "description": "GET /api/locations/{id}/salmon (BC example field only; other fields get 404). Built by backend/bc/salmon.py from Water Survey of Canada gauges 08LE021 and 08LE020, BC orders and guidelines, DFO, NASA MODIS/IMERG/GRACE and the rotation engine. Every number is a SourcedNumber.",
  "type": "object",
  "required": ["location_id", "title", "series_meta", "stations", "flow", "temperature", "run_timing", "early_warning", "water_for_salmon", "summary", "respect", "sources"],
  "$defs": {
    "SN": {"$ref": "sourced_number.schema.json"},
    "SNs": {
      "allOf": [{"$ref": "sourced_number.schema.json"}],
      "required": ["value", "unit", "method", "source"]
    },
    "Source": {"$ref": "sourced_number.schema.json#/$defs/Source"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "num": {"type": ["number", "null"]},
    "threshold": {
      "type": "object", "required": ["id", "kind", "label", "value"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["official", "policy_rule", "our_reference"]},
        "label": {"type": "string"},
        "value": {"$ref": "#/$defs/SNs"},
        "applies": {"type": ["object", "null"]},
        "also": {"type": "array", "items": {"$ref": "#/$defs/Source"}}
      }
    }
  },
  "properties": {
    "location_id": {"const": "bc_salmon_river_forage"},
    "title": {"type": "string"},
    "river": {"type": "string"},
    "generated_at": {"type": "string"},
    "_source": {"type": "string"},
    "series_meta": {
      "type": "object",
      "required": ["flow_daily", "flow_realtime_latest", "flow_percentiles", "water_temp_daily"],
      "properties": {
        "flow_daily": {"type": "object", "required": ["station", "unit", "first", "last"],
          "properties": {"station": {"type": "string"}, "unit": {"const": "m3/s"}, "first": {"$ref": "#/$defs/date"}, "last": {"$ref": "#/$defs/date"}}},
        "flow_realtime_latest": {"type": "object", "required": ["station", "unit", "datetime_utc"]},
        "flow_percentiles": {"type": "object", "required": ["unit", "reference_period"]},
        "water_temp_daily": {"type": "object", "additionalProperties": {"type": "object", "required": ["unit", "first", "last"],
          "properties": {"unit": {"const": "degC"}}}}
      }
    },
    "stations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "name", "lat", "lon", "drainage_area", "distance_from_field", "url"],
        "properties": {"id": {"type": "string", "pattern": "^08[A-Z]{2}\\d{3}$"}, "name": {"type": "string"}, "lat": {"type": "number"}, "lon": {"type": "number"},
          "drainage_area": {"$ref": "#/$defs/SNs"}, "distance_from_field": {"$ref": "#/$defs/SNs"}, "url": {"type": "string", "pattern": "^https://"}}}
    },
    "flow": {
      "type": "object",
      "required": ["station", "mad", "latest", "thresholds", "percentiles_by_doy", "daily", "order_years", "aug_mean_by_year"],
      "properties": {
        "station": {"type": "string"},
        "mad": {"$ref": "#/$defs/SNs"},
        "latest": {
          "type": ["object", "null"], "required": ["datetime_utc", "discharge"],
          "properties": {"discharge": {"$ref": "#/$defs/SNs"}, "level": {"$ref": "#/$defs/SN"}, "percentile_for_date": {"$ref": "#/$defs/SN"}, "pct_of_mad": {"$ref": "#/$defs/SN"}}
        },
        "thresholds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/threshold"}},
        "percentiles_by_doy": {"type": "array", "minItems": 365, "maxItems": 365,
          "items": {"type": "object", "required": ["doy", "p10", "p50", "p90"],
            "properties": {"doy": {"type": "integer", "minimum": 1, "maximum": 365}, "p10": {"$ref": "#/$defs/num"}, "p25": {"$ref": "#/$defs/num"}, "p50": {"$ref": "#/$defs/num"}, "p75": {"$ref": "#/$defs/num"}, "p90": {"$ref": "#/$defs/num"}}}},
        "daily": {"type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["date", "discharge_m3s", "approval"],
            "properties": {"date": {"$ref": "#/$defs/date"}, "discharge_m3s": {"$ref": "#/$defs/num"}, "approval": {"enum": ["approved", "provisional"]}}}},
        "order_years": {"type": "array", "minItems": 2,
          "items": {"type": "object", "required": ["year", "orders", "daily", "aug_mean", "aug_sep_min", "days_below_order_trigger_aug_sep"],
            "properties": {"year": {"type": "integer"}, "orders": {"type": "array"}, "daily": {"type": "array"},
              "data_status": {"enum": ["approved", "provisional"]},
              "aug_mean": {"$ref": "#/$defs/SNs"}, "aug_sep_min": {"$ref": "#/$defs/SNs"}, "days_below_order_trigger_aug_sep": {"$ref": "#/$defs/SNs"}}}},
        "aug_mean_by_year": {"type": "array", "items": {"type": "object", "required": ["year", "aug_mean_m3s"]}}
      }
    },
    "temperature": {
      "type": "object", "required": ["thresholds", "stations", "satellite"],
      "properties": {
        "thresholds": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "label", "value"],
          "properties": {"value": {"$ref": "#/$defs/SNs"}}}},
        "stations": {"type": "array", "items": {"type": "object", "required": ["station", "first", "last", "daily", "summers", "source"],
          "properties": {"daily": {"type": "array", "items": {"type": "object", "required": ["date", "mean_c", "max_c"]}},
            "summers": {"type": "array", "items": {"type": "object", "required": ["year", "days_max_ge_18", "days_max_ge_20", "max_mwmt", "peak"],
              "properties": {"days_max_ge_18": {"$ref": "#/$defs/SNs"}, "days_max_ge_20": {"$ref": "#/$defs/SNs"}, "max_mwmt": {"$ref": "#/$defs/SNs"}, "peak": {"$ref": "#/$defs/SNs"}}}},
            "source": {"$ref": "#/$defs/Source"}}}},
        "satellite": {"type": ["object", "null"]}
      }
    },
    "run_timing": {
      "type": "object", "required": ["months", "species", "irrigation_months", "critical_window"],
      "properties": {
        "species": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["species", "stage", "months", "scope", "sources", "verified"],
          "properties": {"species": {"enum": ["chinook", "coho", "sockeye"]}, "months": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}},
            "scope": {"enum": ["salmon_river", "shuswap", "fraser", "not_published"]}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Source"}}}}},
        "irrigation_months": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}}
      }
    },
    "early_warning": {
      "type": "object", "required": ["label", "indicators", "table"],
      "properties": {
        "label": {"const": "Rule of thumb, not a forecast model"},
        "indicators": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["indicator", "label", "unit", "spearman_r", "n_years", "years"],
          "properties": {"spearman_r": {"$ref": "#/$defs/SN"}, "hit_rate": {"$ref": "#/$defs/SN"}, "value_2026": {"$ref": "#/$defs/SN"}, "pct_rank_2026": {"$ref": "#/$defs/SN"}}}},
        "table": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["year", "aug_mean_m3s"]}}
      }
    },
    "water_for_salmon": {
      "type": "object", "required": ["window", "field_area", "reference_low_flow", "items", "scale_up"],
      "properties": {
        "field_area": {"$ref": "#/$defs/SNs"},
        "reference_low_flow": {"$ref": "#/$defs/SNs"},
        "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object",
          "required": ["strategy_id", "short_name", "net_need_aug_sep_mm", "draw_aug_sep_mm", "draw_aug_sep_m3", "draw_rate_l_s", "share_of_low_aug_flow_pct"],
          "properties": {"net_need_aug_sep_mm": {"$ref": "#/$defs/SNs"}, "draw_aug_sep_mm": {"$ref": "#/$defs/SNs"}, "draw_aug_sep_m3": {"$ref": "#/$defs/SNs"},
            "draw_rate_l_s": {"$ref": "#/$defs/SNs"}, "share_of_low_aug_flow_pct": {"$ref": "#/$defs/SNs"}}}},
        "scale_up": {"type": "object", "required": ["label", "rows", "note"],
          "properties": {"label": {"type": "string", "pattern": "Illustration"},
            "rows": {"type": "array", "items": {"type": "object", "required": ["licences", "assumed_ha_per_licence", "draw_rate_l_s", "share_of_low_aug_flow_pct"],
              "properties": {"assumed_ha_per_licence": {"allOf": [{"$ref": "#/$defs/SNs"}]}}}}}}
      }
    },
    "summary": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "respect": {
      "type": "object", "required": ["public_data_only", "reserve_land_analysed", "statements", "links"],
      "properties": {
        "public_data_only": {"const": true},
        "reserve_land_analysed": {"const": false},
        "statements": {"type": "array", "contains": {"const": "Built to be co-developed; we'd welcome the Nation's guidance on what matters."}},
        "links": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "url"], "properties": {"url": {"type": "string", "pattern": "^https://"}}}}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}}
  }
}
