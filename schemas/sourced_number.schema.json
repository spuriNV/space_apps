{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/sourced_number.schema.json",
  "title": "SourcedNumber",
  "description": "Spec B3. Every numeric leaf. value may be null (user input / unknown); a non-null value must carry a source.",
  "type": "object",
  "required": ["value", "method"],
  "properties": {
    "value": {"type": ["number", "null"]},
    "unit": {"type": "string"},
    "low": {"type": ["number", "null"]},
    "high": {"type": ["number", "null"]},
    "method": {"enum": ["lookup", "computed", "assumed", "model", "measured"]},
    "source": {"$ref": "#/$defs/Source"},
    "note": {"type": "string"}
  },
  "if": {"required": ["value"], "properties": {"value": {"type": "number"}}},
  "then": {"required": ["source"]},
  "$defs": {
    "Source": {
      "type": "object",
      "required": ["id", "url", "verified"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "accessed": {"type": "string"},
        "verified": {"type": "boolean"},
        "internal": {"type": "boolean", "description": "true when url is a repo path or internal identifier with no public page (set by the API response layer); show the title, do not link"}
      },
      "if": {"properties": {"verified": {"const": true}}},
      "then": {"required": ["accessed"], "properties": {"url": {"type": "string", "minLength": 1}}}
    }
  }
}
