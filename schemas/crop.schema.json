{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/crop.schema.json",
  "title": "Crop",
  "type": "object",
  "required": ["id", "name", "family", "role", "legume", "root", "kc", "stage_lengths_days", "cover_by_stage", "ratings_0_4", "yield_range", "drainage_classes_ok", "seeding_window", "pest_notes", "cautions", "seed_cost_per_ha", "sources"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "family": {"type": "string"},
    "role": {"type": "array", "items": {"enum": ["cash", "cover", "forage", "fallow", "break", "water"]}},
    "legume": {"type": "boolean"},
    "root": {"type": "string"},
    "kc": {
      "type": "object", "required": ["ini", "mid", "end"],
      "properties": {"ini": {"$ref": "sourced_number.schema.json"}, "mid": {"$ref": "sourced_number.schema.json"}, "end": {"$ref": "sourced_number.schema.json"}}
    },
    "stage_lengths_days": {
      "type": ["object", "null"], "description": "null for non-crop entries (flooded field)", "required": ["ini", "dev", "mid", "late", "source"],
      "properties": {"ini": {"type": "integer"}, "dev": {"type": "integer"}, "mid": {"type": "integer"}, "late": {"type": "integer"}, "source": {"type": "string"}}
    },
    "cover_by_stage": {
      "type": "object", "required": ["ini", "dev", "mid", "late"],
      "properties": {
        "ini": {"type": "number", "minimum": 0, "maximum": 1}, "dev": {"type": "number", "minimum": 0, "maximum": 1},
        "mid": {"type": "number", "minimum": 0, "maximum": 1}, "late": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string"}, "verified": {"type": "boolean"}, "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ratings_0_4": {
      "type": "object",
      "required": ["erosion_reduction", "soil_builder", "lasting_residue", "nitrogen_fixation", "nitrogen_scavenging", "compaction_reduction", "forage_harvest_value", "weed_suppression", "tolerance_flood", "tolerance_drought"],
      "additionalProperties": {"$ref": "sourced_number.schema.json"}
    },
    "yield_range": {"$ref": "sourced_number.schema.json"},
    "drainage_classes_ok": {"description": "list of classes, or engine form {value: [classes], method, verified, note}", "oneOf": [
      {"type": "array", "items": {"type": "string"}},
      {"type": "object", "required": ["value"], "properties": {"value": {"type": "array", "items": {"type": "string"}}, "method": {"type": "string"}, "verified": {"type": "boolean"}, "note": {"type": "string"}}}
    ]},
    "seeding_window": {
      "type": ["object", "null"], "description": "null for non-crop entries (fallow, flooded field)", "required": ["start", "end", "verified"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d\\d-\\d\\d$"}, "end": {"type": "string", "pattern": "^\\d\\d-\\d\\d$"},
        "best": {"type": "string"}, "verified": {"type": "boolean"}
      }
    },
    "pest_notes": {"type": "array", "items": {"type": "string"}},
    "cautions": {"type": "array", "items": {"type": "string"}},
    "seed_cost_per_ha": {"$ref": "sourced_number.schema.json"},
    "explainer_card": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "url"], "properties": {"id": {"type": "string"}, "url": {"type": "string"}}}
    }
  }
}
