{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/nation.schema.json",
  "title": "NationTools",
  "description": "Responses of GET /api/locations/{id}/nation[/drought_rotation|/groundwater|/land_season|/funding|/report.json]. Pick a response with #/$defs/Summary, DroughtRotation, Groundwater, LandSeason, Funding, Report. For First Nations and tribal farm, lands and water staff; any location the API serves (presets and pt_ ids).",
  "$defs": {
    "url": {"type": "string", "pattern": "^https?://"},
    "num": {"type": ["number", "null"]},
    "source": {"type": "object", "required": ["id", "title", "url", "verified"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "url": {"$ref": "#/$defs/url"}, "verified": {"type": "boolean"}}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "status": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["real", "not_computed"]}, "reason": {"type": ["string", "null"]}},
      "if": {"properties": {"status": {"const": "not_computed"}}}, "then": {"required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}},
    "base": {"type": "object", "required": ["location_id", "_source"], "properties": {"location_id": {"type": "string"}, "_source": {"enum": ["real", "live"]}}},
    "Summary": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object",
      "required": ["location", "land_status", "nearest_nations", "place_names", "tools", "sources", "caveats"],
      "properties": {
        "location": {"type": "object", "required": ["name", "lat", "lon", "region", "jurisdiction"],
          "properties": {"region": {"enum": ["ca", "bc", "us"]}, "jurisdiction": {"enum": ["CA", "BC", "US"]}, "lat": {"type": "number"}, "lon": {"type": "number"}}},
        "land_status": {"type": "object", "required": ["value", "detail", "source"],
          "properties": {"value": {"enum": ["reserve", "trust", "fee", "private", "unknown"]}, "detail": {"type": "string"}, "area_name": {"type": ["string", "null"]},
                         "nation": {"type": ["string", "null"]}, "source": {"type": "object", "required": ["title", "url"], "properties": {"url": {"$ref": "#/$defs/url"}}}}},
        "nearest_nations": {"type": "array", "items": {"type": "object", "required": ["nation", "area_kind", "distance_km", "inside"],
          "properties": {"nation": {"type": "string"}, "nearest_area": {"type": "string"}, "area_kind": {"type": "string"}, "distance_km": {"type": "number", "minimum": 0}, "inside": {"type": "boolean"}}}},
        "place_names": {"type": "array", "items": {"type": "object", "required": ["name", "english", "nation", "source_url", "source_type", "approved_by_nation"],
          "properties": {"source_url": {"$ref": "#/$defs/url"}, "approved_by_nation": {"type": "boolean"}}}},
        "tools": {"type": "object", "required": ["drought_rotation", "groundwater", "land_season", "funding", "report_pdf", "report_json"]},
        "sources": {"$ref": "#/$defs/sources"}, "caveats": {"type": "array", "items": {"type": "string"}}}}]},
    "Rotation": {"type": "object",
      "required": ["id", "name", "water_mm_season", "water_mm_after_cutoff", "erosion_index", "soil_cover_pct", "n_fixation_score", "n_balance_kg_ha", "dry_year_rank"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "is_baseline": {"type": "boolean"},
        "water_mm_season": {"$ref": "#/$defs/num"}, "water_mm_after_cutoff": {"$ref": "#/$defs/num"}, "share_after_cutoff_pct": {"$ref": "#/$defs/num"},
        "irrigation_need_mm_season": {"$ref": "#/$defs/num"}, "irrigation_need_mm_after_cutoff": {"$ref": "#/$defs/num"}, "irrigation_need_af_ac": {"$ref": "#/$defs/num"},
        "erosion_index": {"$ref": "#/$defs/num"}, "erosion_score": {"$ref": "#/$defs/num"}, "bare_days_per_year": {"$ref": "#/$defs/num"},
        "soil_cover_pct": {"$ref": "#/$defs/num"}, "n_fixation_score": {"$ref": "#/$defs/num"}, "n_scavenging_score": {"$ref": "#/$defs/num"},
        "n_balance_kg_ha": {"type": "null"}, "dry_year_rank": {"type": ["integer", "null"]}}},
    "DroughtRow": {"type": "object", "required": ["year", "partial", "imerg_precip_anom_pct", "smap_rootzone_pctl", "gracedadm_gw_pctl", "power_et0_mm"],
      "properties": {"year": {"type": "integer"}, "partial": {"type": "boolean"}, "imerg_precip_anom_pct": {"$ref": "#/$defs/num"}, "smap_rootzone_pctl": {"$ref": "#/$defs/num"},
        "gracedadm_gw_pctl": {"$ref": "#/$defs/num"}, "power_et0_mm": {"$ref": "#/$defs/num"}}},
    "SeriesStatus": {"type": "object", "required": ["power_et0", "imerg", "grace", "smap"],
      "properties": {"power_et0": {"$ref": "#/$defs/status"}, "imerg": {"$ref": "#/$defs/status"}, "grace": {"$ref": "#/$defs/status"}, "smap": {"$ref": "#/$defs/status"}}},
    "DroughtRotation": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object",
      "required": ["cutoff_date", "rotations", "cutoff_scenarios", "drought_history", "series_status", "sources", "caveats"],
      "properties": {"cutoff_date": {"type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
        "rotations": {"type": "array", "items": {"$ref": "#/$defs/Rotation"}},
        "cutoff_scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["cutoff_date", "rotations"],
          "properties": {"rotations": {"type": "array", "items": {"type": "object", "required": ["id", "water_mm_after_cutoff", "unmet_water_share_pct", "yield_loss_pct"],
            "properties": {"yield_loss_pct": {"type": "null"}}}}}}},
        "drought_history": {"type": "array", "items": {"$ref": "#/$defs/DroughtRow"}},
        "series_status": {"$ref": "#/$defs/SeriesStatus"}, "sources": {"$ref": "#/$defs/sources"}, "caveats": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}]},
    "Groundwater": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object",
      "required": ["b118_subbasin_id", "b118_subbasin_name", "gsa_names", "sgma_status", "gw_pctl_weekly", "gw_pctl_status", "pumping_need_af_by_rotation", "tribal_links", "caveat", "sources"],
      "properties": {"b118_subbasin_id": {"type": ["string", "null"]}, "b118_subbasin_name": {"type": ["string", "null"]}, "gsa_names": {"type": "array", "items": {"type": "string"}},
        "sgma_status": {"type": ["string", "null"]},
        "gw_pctl_weekly": {"type": "array", "items": {"type": "object", "required": ["week_start", "gw_pctl"]}},
        "gw_pctl_status": {"$ref": "#/$defs/status"}, "smap_status": {"$ref": "#/$defs/status"},
        "pumping_need_af_by_rotation": {"type": "array", "items": {"type": "object", "required": ["id", "pumping_need_af"]}},
        "tribal_links": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "url", "verified"], "properties": {"url": {"$ref": "#/$defs/url"}, "verified": {"type": "boolean"}}}},
        "caveat": {"type": "string", "minLength": 20}, "sources": {"$ref": "#/$defs/sources"}}}]},
    "Fire": {"type": "object", "required": ["window_days", "status", "count", "detections", "within_km", "source"],
      "properties": {"status": {"enum": ["real", "not_computed"]}, "reason": {"type": ["string", "null"]}, "window_days": {"type": "integer"}, "within_km": {"type": "number"},
        "count": {"type": "integer"}, "detections": {"type": "array", "items": {"type": "object", "required": ["date", "lat", "lon", "distance_km"]}}, "source": {"$ref": "#/$defs/source"}}},
    "LandSeason": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object",
      "required": ["ndvi_weekly", "ndvi_status", "phenology", "phenology_note", "snow", "fire_detections_365d", "fire_detections_7d", "burn_scars", "regs_links", "harvest_rights_note", "sources", "caveats"],
      "properties": {"ndvi_weekly": {"type": "array", "items": {"type": "object", "required": ["week_start", "ndvi"]}}, "ndvi_status": {"$ref": "#/$defs/status"},
        "phenology": {"type": "object", "required": ["by_year", "greenup_doy", "peak_doy", "senescence_doy"],
          "properties": {"greenup_doy": {"type": ["integer", "null"]}, "peak_doy": {"type": ["integer", "null"]}, "senescence_doy": {"type": ["integer", "null"]}}},
        "phenology_note": {"type": "string", "pattern": "proxy"},
        "snow": {"allOf": [{"$ref": "#/$defs/status"}, {"type": "object", "required": ["years", "snow_off_doy"], "properties": {"snow_off_doy": {"type": ["integer", "null"]}}}]},
        "fire_detections_365d": {"$ref": "#/$defs/Fire"}, "fire_detections_7d": {"$ref": "#/$defs/Fire"},
        "burn_scars": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "url"], "properties": {"url": {"$ref": "#/$defs/url"}}}},
        "regs_links": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "url"], "properties": {"url": {"$ref": "#/$defs/url"}}}},
        "harvest_rights_note": {"type": "string", "minLength": 20}, "sources": {"$ref": "#/$defs/sources"}, "caveats": {"type": "array", "items": {"type": "string"}}}}]},
    "Program": {"type": "object",
      "required": ["id", "name", "agency", "eligible", "funds", "typical_amount", "status", "deadline", "url", "url_checked", "verified", "how_croplytics_helps", "report_sections", "matched_reason", "jurisdictions"],
      "properties": {"status": {"enum": ["open", "closed", "rolling", "unknown"]}, "deadline": {"type": ["string", "null"]}, "url": {"$ref": "#/$defs/url"}, "verified": {"type": "boolean"},
        "report_sections": {"type": "array", "minItems": 1, "items": {"enum": ["field_outline", "drought_history", "water_baseline", "rotation_comparison", "water_context", "sources_caveats"]}},
        "matched_reason": {"type": "string", "minLength": 10}, "jurisdictions": {"type": "array", "items": {"enum": ["US", "CA", "CAN", "BC"]}}}},
    "Funding": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["jurisdiction", "location_jurisdiction", "as_of", "programs", "counts", "disclaimer"],
      "properties": {"jurisdiction": {"enum": ["US", "CA", "CAN", "BC"]}, "programs": {"type": "array", "items": {"$ref": "#/$defs/Program"}}, "counts": {"type": "object"}}}]},
    "Report": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object",
      "required": ["title", "generated", "program", "report_sections", "field_outline", "drought_history", "water_baseline", "rotation_comparison", "context", "sources", "caveats"],
      "properties": {"program": {"type": ["object", "null"], "required": ["id", "name", "agency", "url"]},
        "field_outline": {"type": "object", "required": ["name", "lat", "lon", "area_ha", "land_status", "land_cover"]},
        "drought_history": {"type": "array", "items": {"$ref": "#/$defs/DroughtRow"}}, "rotation_comparison": {"type": "array", "items": {"$ref": "#/$defs/Rotation"}},
        "context": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["groundwater", "river"]}}},
        "sources": {"$ref": "#/$defs/sources"}, "caveats": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}]}
  }
}
