{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/first_nations.schema.json",
  "title": "FirstNations",
  "description": "GET /api/locations/{id}/first_nations (BC fields only; California fields get 404). Facts and links from docs/bc-first-nations.md; reserves from the BC CLSS reserve layer. No reserve land is analysed.",
  "type": "object",
  "required": ["location_id", "statement", "field_on_reserve", "nearest_km", "lower_river_nation", "nearby", "engagement_steps", "principles", "contacts", "water_timeline", "source"],
  "$defs": {
    "link": {"type": "string", "pattern": "^https://"}
  },
  "properties": {
    "location_id": {"type": "string", "pattern": "^bc_[a-z0-9_]+$"},
    "statement": {"const": "Built to be co-developed with First Nations farmers; we'd only add a reserve field with the Nation's permission."},
    "field_on_reserve": {"const": false},
    "nearest_km": {"type": "number", "minimum": 0},
    "nearest_reserve": {"type": "string"},
    "nearest_nation": {"type": "string"},
    "lower_river_nation": {
      "type": "object", "required": ["nation", "reserve", "note", "url"],
      "properties": {"nation": {"type": "string"}, "band_number": {"type": "string"}, "reserve": {"type": "string"}, "note": {"type": "string"}, "url": {"$ref": "#/$defs/link"}, "verified": {"type": "boolean"}}
    },
    "nearby": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["reserve", "nation", "band_number", "area_ha", "distance_to_field_km"],
        "properties": {"reserve": {"type": "string"}, "nation": {"type": "string"}, "band": {"type": "string"}, "band_number": {"type": "string"},
          "area_ha": {"type": "number"}, "distance_to_field_km": {"type": "number", "minimum": 0}}}
    },
    "engagement_steps": {"type": "array", "minItems": 5, "maxItems": 6, "items": {"type": "string"}},
    "principles": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "required": ["id", "name", "description", "url"],
        "properties": {"id": {"enum": ["ocap", "care", "tcps2_ch9"]}, "name": {"type": "string"}, "description": {"type": "string"}, "url": {"$ref": "#/$defs/link"}, "verified": {"type": "boolean"}}}
    },
    "contacts": {
      "type": "array",
      "items": {"type": "object", "required": ["nation", "department", "url"], "additionalProperties": false,
        "properties": {"nation": {"type": "string"}, "department": {"type": "string"}, "url": {"$ref": "#/$defs/link"}}}
    },
    "water_timeline": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["date", "title", "url", "verified"],
        "properties": {"date": {"type": "string", "pattern": "^\\d{4}(-\\d\\d-\\d\\d)?$"}, "title": {"type": "string"}, "url": {"$ref": "#/$defs/link"},
          "verified": {"type": "boolean"}, "licences": {"type": "integer"}, "effective": {"type": "string"}}}
    },
    "reserves_geojson": {"type": ["string", "null"]},
    "source": {"type": "object", "required": ["url", "verified"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
